      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangguitao666/meeting-suite.git",
    "directory": "meeting-suite"
  },
  "homepage": "https://github.com/zhangguitao666/meeting-suite",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "meeting",
    "minutes",
    "calendar",
    "deepseek-harness"
  ],
